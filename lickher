    ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true,
}

local function vcCloneCharacter(char)
    if not char then return nil, nil end
    local saved = {}
    local function mark(o)
        if not o or saved[o] ~= nil then return end
        saved[o] = o.Archivable
        pcall(function() o.Archivable = true end)
        for _, ch in ipairs(o:GetChildren()) do mark(ch) end
    end
    mark(char)
    local ok, clone = pcall(function() return char:Clone() end)
    for o, val in pairs(saved) do pcall(function() o.Archivable = val end) end
    if not ok or not clone then return nil, nil end

    local kill = {}
    for _, d in ipairs(clone:GetDescendants()) do
        if KILL_CLASSES[d.ClassName] then table.insert(kill, d) end
    end
    for _, d in ipairs(kill) do pcall(function() d:Destroy() end) end

    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.CanQuery = false
            d.CanTouch = false
            d.CastShadow = false
            d.Massless = true
            d.LocalTransparencyModifier = 0
            if d.Name == "HumanoidRootPart" then
                d.Transparency = 1
            elseif d.Name == "UpperTorso" or d.Name == "LowerTorso" or d.Name == "Torso"
                or d.Name == "Head" or d.Name:find("Arm") or d.Name:find("Leg")
                or d.Name:find("Hand") or d.Name:find("Foot") then
                if d.Transparency > 0.5 then d.Transparency = 0 end
            end
        elseif d:IsA("Humanoid") then
            d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            d.PlatformStand = true
            d.WalkSpeed = 0
            d.JumpPower = 0
        end
    end

    local function collectByName(root)
        local map, n = {}, 0
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("BasePart") then
                local key = (d.Parent and d.Parent.Name or "") .. "/" .. d.Name
                if map[key] then n = n + 1 key = key .. "#" .. n end
                map[key] = d
            end
        end
        return map
    end
    local realMap, cloneMap = collectByName(char), collectByName(clone)
    local pairsList = {}
    for key, realPart in pairs(realMap) do
        local cp = cloneMap[key]
        if cp then table.insert(pairsList, { real = realPart, clone = cp, key = key }) end
    end
    clone.Name = "VC_" .. tostring(char.Name)
    return clone, pairsList
end

local function vcCountBodyPairs(list)
    local n = 0
    for _, p in ipairs(list or {}) do
        local name = p.real and p.real.Name
        if name == "UpperTorso" or name == "LowerTorso" or name == "Torso" or name == "Head" or name == "HumanoidRootPart" then
            n = n + 1
        end
    end
    return n
end

local function vcBuildEntry(plr)
    if not plr or plr == LocalPlayer or not Toggles.Chams then return nil end
    local char = plr.Character
    if not char then vcDestroyEntry(plr) return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then vcDestroyEntry(plr) return nil end
    local hasTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso")
    if not hasTorso or not char:FindFirstChild("Head") then return nil end

    local e = ViewportChams.Entries[plr]
    if e and e.char == char and e.model and e.model.Parent then
        if not (vcCountBodyPairs(e.pairs) < 2 and (not e.lastBuild or (tick() - e.lastBuild) > 2)) then
            return e
        end
    end
    local now = tick()
    if e and e.lastBuild and (now - e.lastBuild) < ViewportChams.RebuildCooldown then return e end

    vcDestroyEntry(plr)
    if not vcEnsureGui() or not ViewportChams.World then return nil end

    local clone, pairsList = vcCloneCharacter(char)
    if not clone then
        ViewportChams.Entries[plr] = { lastBuild = now, fail = true }
        return nil
    end
    clone.Parent = ViewportChams.World
    e = { model = clone, pairs = pairsList or {}, char = char, lastBuild = now, fail = false }
    ViewportChams.Entries[plr] = e
    return e
end

local function vcSyncEntry(e)
    if not e or not e.model or not e.pairs then return end
    if not e.char or not e.char.Parent then return end
    local anyAlive = false
    for i = #e.pairs, 1, -1 do
        local pair = e.pairs[i]
        local rp, cp = pair.real, pair.clone
        if not rp or not rp.Parent or not cp or not cp.Parent then
            if cp and cp.Parent then pcall(function() cp:Destroy() end) end
            table.remove(e.pairs, i)
        else
            anyAlive = true
            cp.CFrame = rp.CFrame
            if cp.Size ~= rp.Size then cp.Size = rp.Size end
        end
    end
    if not anyAlive then
        if e.model then pcall(function() e.model:Destroy() end) end
        e.model, e.pairs, e.char = nil, {}, nil
    end
end

local function vcHookPlayer(plr)
    if not plr or plr == LocalPlayer then return end
    vcDisconnectPlayer(plr)
    local conns = {}
    table.insert(conns, plr.CharacterAdded:Connect(function(char)
        vcDestroyEntry(plr)
        if not Toggles.Chams then return end
        task.spawn(function()
            local waits = { 0.5, 1.2, 2.5 }
            for i, w in ipairs(waits) do
                task.wait(i == 1 and w or (w - waits[i - 1]))
                if not Toggles.Chams or not plr.Parent or plr.Character ~= char then return end
                vcDestroyEntry(plr)
                vcBuildEntry(plr)
            end
        end)
    end))
    table.insert(conns, plr.CharacterRemoving:Connect(function() vcDestroyEntry(plr) end))
    ViewportChams.CharConns[plr] = conns
end

local function vcSetEnabled(on)
    Toggles.Chams = on and true or false
    if on then
        vcEnsureGui()
        if ViewportChams.Gui then ViewportChams.Gui.Enabled = true end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                vcHookPlayer(plr)
                vcBuildEntry(plr)
            end
        end
        if not ViewportChams.Conn then
            local lastVc = 0
            ViewportChams.Conn = RunService.Heartbeat:Connect(function()
                if not Toggles.Chams or not ESPAlive or not ViewportChams.Cam then return end
                local now = tick()
                local cam = workspace.CurrentCamera
                if cam then
                    ViewportChams.Cam.CFrame = cam.CFrame
                    ViewportChams.Cam.FieldOfView = cam.FieldOfView
                end
                if now - lastVc < 0.033 then return end
                lastVc = now
                local camPos = cam and cam.CFrame.Position
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local char = plr.Character
                        local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                        if not root or not camPos then
                            vcDestroyEntry(plr)
                        elseif (root.Position - camPos).Magnitude > ViewportChams.MaxDist then
                            vcDestroyEntry(plr)
                        else
                            local e = ViewportChams.Entries[plr]
                            if not e or not e.model or e.char ~= char then e = vcBuildEntry(plr) end
                            if e and e.model then vcSyncEntry(e) end
                        end
                    end
                end
            end)
            table.insert(Connections, ViewportChams.Conn)
        end
    else
        if ViewportChams.Gui then ViewportChams.Gui.Enabled = false end
        local list = {}
        for plr in pairs(ViewportChams.Entries) do table.insert(list, plr) end
        for _, plr in ipairs(list) do vcDestroyEntry(plr) end
    end
end

local function vcCleanupAll()
    if ViewportChams.Conn then pcall(function() ViewportChams.Conn:Disconnect() end) ViewportChams.Conn = nil end
    for plr in pairs(ViewportChams.CharConns) do vcDisconnectPlayer(plr) end
    local list = {}
    for plr in pairs(ViewportChams.Entries) do table.insert(list, plr) end
    for _, plr in ipairs(list) do vcDestroyEntry(plr) end
    if ViewportChams.Gui then pcall(function() ViewportChams.Gui:Destroy() end) end
    ViewportChams.Gui, ViewportChams.Frame, ViewportChams.World, ViewportChams.Cam = nil, nil, nil, nil
end

