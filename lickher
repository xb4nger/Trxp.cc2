local function QueueFullScript()
    local queue = queue_on_teleport or queueonteleport

    if not queue and syn then
        queue = syn.queue_on_teleport
    end

    if type(queue) ~= "function" then
        warn("Queue on teleport is not supported by this executor")
        return false
    end

    local queuedCode = [[
        repeat task.wait() until game:IsLoaded()

        local Players = game:GetService("Players")
        repeat task.wait() until Players.LocalPlayer

        task.wait(3)

        local url = "https://raw.githubusercontent.com/xb4nger/Trxp.cc2/refs/heads/main/lickher"

        local success, source = pcall(function()
            return game:HttpGet(url)
        end)

        if not success then
            warn("Failed to download main script: " .. tostring(source))
            return
        end

        local scriptFunction, compileError = loadstring(source)

        if not scriptFunction then
            warn("Script compile error: " .. tostring(compileError))
            return
        end

        local executed, executionError = pcall(scriptFunction)

        if not executed then
            warn("Script execution error: " .. tostring(executionError))
        end
    ]]

    local success, err = pcall(function()
        queue(queuedCode)
    end)

    if not success then
        warn("Queue failed: " .. tostring(err))
        return false
    end

    return true
end

