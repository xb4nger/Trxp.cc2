getgenv().fastFallSpeed = -200

local function getHumanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function keepUpright()
    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.RotVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z))
end

local function isGrounded(hrp)
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LocalPlayer.Character}
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    return Workspace:Raycast(hrp.Position, Vector3.new(0,-6,0), rp) ~= nil
end

local function teleportInMoveDirection(dist)
    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    local md = h.MoveDirection
    if md.Magnitude < 0.05 then return end
    local moveDir = Vector3.new(md.X, 0, md.Z)
    if moveDir.Magnitude < 0.05 then return end
    moveDir = moveDir.Unit
    h:ChangeState(0)
    local t0 = tick()
    while LocalPlayer:GetAttribute("LastACPos") and (tick() - t0) < 0.35 do task.wait() end
    local origin = hrp.Position
    local dir = moveDir * dist
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {c}
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    local rc = Workspace:Raycast(origin, dir, rp)
    local pos = rc and (rc.Position - moveDir * 1.5) or (origin + dir)
    if not isGrounded(hrp) then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, getgenv().fastFallSpeed, hrp.Velocity.Z)
    else
        hrp.Velocity = Vector3.zero
    end
    local look = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
    if look.Magnitude < 0.05 then look = moveDir end
    hrp.CFrame = CFrame.new(pos, pos + look.Unit)
    keepUpright()
end

local function startWalkLoop()
    if getgenv().moveConnection then getgenv().moveConnection:Disconnect() end
    getgenv().moveConnection = RunService.Heartbeat:Connect(function(dt)
        if getgenv().movementEnabled then
            local h = getHumanoid()
            if h then
                keepUpright()
                if h.MoveDirection.Magnitude > 0 then
                    teleportInMoveDirection(getgenv().currentWalkSpeed * dt)
                else
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and not isGrounded(hrp) then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, getgenv().fastFallSpeed, hrp.Velocity.Z)
                    end
                end
            end
        end
    end)
end

local function stopWalkLoop()
    if getgenv().moveConnection then getgenv().moveConnection:Disconnect() end
    keepUpright()
end

