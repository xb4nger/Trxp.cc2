local KILL_CLASSES = {
    Script = true, LocalScript = true, ModuleScript = true, Sound = true, Highlight = true,
    BillboardGui = true, SurfaceGui = true, ProximityPrompt = true, ClickDetector = true,
    TouchTransmitter = true, AnimationController = true, Animator = true,
    BindableEvent = true, BindableFunction = true, RemoteEvent = true, RemoteFunction = true,
    WeldConstraint = true, Weld = true, Motor6D = true, ManualWeld = true, ManualGlue = true,
    Snap = true, RigidConstraint = true, HingeConstraint = true, BallSocketConstraint = true,
    Attachment = true, VectorForce = true, BodyVelocity = true, BodyGyro = true,
