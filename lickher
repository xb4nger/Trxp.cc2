getgenv().nearSeat = function(hrp)
    local m = Workspace:FindFirstChild("1# Map")
    if not m then return nil end
    local r, d
    for _, v in m:GetDescendants() do
        if v:IsA("Seat") and not v.Disabled and v.CanCollide then
            if v.Position.Y < hrp.Position.Y - 8 then continue end
            local x = (v.Position - hrp.Position).Magnitude
            if not d or x < d then d = x; r = v end
        end
    end
    if r then r.CFrame = r.CFrame + Vector3.new(0, 1.5, 0) end
    return r
end

getgenv().startFlying = function()
    if getgenv().flying then return end
    getgenv().flying = true
    local P = LocalPlayer
    local ch = P.Character or P.CharacterAdded:Wait()
    local h = ch:WaitForChild("Humanoid")
    local hrp = ch:WaitForChild("HumanoidRootPart")
    h.AutoRotate = false
    local anim = ch:FindFirstChild("Animate")
    if anim then anim.Disabled = true end
    getgenv().seat = getgenv().nearSeat(hrp)
    if getgenv().seat then
        getgenv().seat.Anchored = false
        getgenv().seat.CFrame = hrp.CFrame * CFrame.new(0, -3, 0)
        task.wait()
        getgenv().seat:Sit(h)
    end
    getgenv().bv = Instance.new("BodyVelocity", hrp)
    getgenv().bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    getgenv().bg = Instance.new("BodyGyro", hrp)
    getgenv().bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    getgenv().bg.P = 50000
    local touchUp = false
    UserInputService.TouchStarted:Connect(function() touchUp = true end)
    UserInputService.TouchEnded:Connect(function() touchUp = false end)
    getgenv().con = RunService.RenderStepped:Connect(function()
        if not getgenv().flying then return end
        getgenv().R6(ch)
        local cam = workspace.CurrentCamera.CFrame
        local d = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then d += cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then d -= cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then d -= cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then d += cam.RightVector end
        d += h.MoveDirection
        if touchUp then d += Vector3.new(0, 1, 0) end
        local spd = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and (getgenv().flightSpeed * getgenv().boost) or getgenv().flightSpeed
        getgenv().bv.Velocity = d.Magnitude > 0 and d.Unit * spd or Vector3.zero
        local l = cam.LookVector
        local flat = Vector3.new(l.X, 0, l.Z)
        if flat.Magnitude > 0 then
            flat = flat.Unit
            getgenv().lastLook = getgenv().lastLook and getgenv().lastLook:Lerp(flat, getgenv().camSmooth) or flat
            getgenv().bg.CFrame = CFrame.new(hrp.Position, hrp.Position + getgenv().lastLook)
        end
    end)
end

