local function getValidTool()
    local Character = LocalPlayer.Character
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    if not Character then return nil end
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") and not BLACKLIST[tool.Name] then return tool end
    end
    if Backpack then
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") and not BLACKLIST[tool.Name] then return tool end
        end
    end
    return nil
end

local function getPing()
    local t0 = tick()
    local v = Instance.new("BoolValue")
    v.Parent = ReplicatedStorage
    task.wait(0.1)
    local t1 = tick()
    v:Destroy()
    return math.clamp((t1 - t0) * 1000, 50, 300)
end

local function dupeMethod1()
    local Tool = getValidTool()
    if not Tool then return end
    Tool.Parent = LocalPlayer.Backpack
    task.wait(0.5)
    local ToolName = Tool.Name
    local ToolId
    local delay = 0.25 + ((math.clamp(getPing(), 0, 300) / 300) * 0.03)
    local conn
    local market = ReplicatedStorage:FindFirstChild("MarketItems")
    if market then
        conn = market.ChildAdded:Connect(function(item)
            if item.Name == ToolName then
                local owner = item:FindFirstChild("owner")
                if owner and owner.Value == LocalPlayer.Name then
                    ToolId = item:GetAttribute("SpecialId")
                end
            end
        end)
    end
    pcall(function() ReplicatedStorage.ListWeaponRemote:FireServer(ToolName, 99999) end)
    task.wait(delay)
    pcall(function() ReplicatedStorage.BackpackRemote:InvokeServer("Store", ToolName) end)
    task.wait(3)
    if ToolId then
        pcall(function() ReplicatedStorage.BuyItemRemote:FireServer(ToolName, "Remove", ToolId) end)
    end
    pcall(function() ReplicatedStorage.BackpackRemote:InvokeServer("Grab", ToolName) end)
    if conn then conn:Disconnect() end
end

local function dupe()
    if dupemethod == "Market" then
