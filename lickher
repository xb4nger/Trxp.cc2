local FlyToggle = MoveLeft:Toggle({
    Name = "Fly",
    Flag = "FlyToggle",
    Default = false,
    Value = false,
    Callback = function(state)
        getgenv().FLYING = state
        if state then
            if getgenv().FlyMethod == 1 then
                getgenv().SwimMethod = true
                task.wait(0.3)
                local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                local hum = char and char:FindFirstChild("Humanoid")
                if not hum then return end
                hum.PlatformStand = true
                local Head = char:WaitForChild("Head")
                Head.Anchored = true
                getgenv().RemovedHair = {}
                for _, acc in ipairs(char:GetChildren()) do
                    if acc:IsA("Accessory") then
                        local handle = acc:FindFirstChild("Handle")
                        if handle then
                            local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                            if mesh and (mesh.MeshId:lower():find("hair") or acc.Name:lower():find("hair")) then
                                getgenv().RemovedHair[acc] = true
                                acc.Parent = nil
                            end
                        elseif acc.Name:lower():find("hair") then
                            getgenv().RemovedHair[acc] = true
                            acc.Parent = nil
                        end
                    end
                end
                local camera = workspace.CurrentCamera
                camera.CameraSubject = Head
                camera.CameraType = Enum.CameraType.Custom
                LocalPlayer.CameraMinZoomDistance = 0.5
                LocalPlayer.CameraMaxZoomDistance = 0.5
                if getgenv().CFloop then getgenv().CFloop:Disconnect() end
                getgenv().CFloop = RunService.Heartbeat:Connect(function(dt)
                    local move = hum.MoveDirection * (getgenv().flySpeed * dt)
                    local hcf = Head.CFrame
                    local ccf = camera.CFrame
                    local off = hcf:ToObjectSpace(ccf).Position
                    ccf = ccf * CFrame.new(-off.X, -off.Y, -off.Z + 1)
                    local cp = ccf.Position
                    local hp = hcf.Position
                    local vel = CFrame.new(cp, Vector3.new(hp.X, cp.Y, hp.Z)):VectorToObjectSpace(move)
                    Head.CFrame = CFrame.new(hp) * (ccf - cp) * CFrame.new(vel)
                    camera.CameraSubject = Head
                    LocalPlayer.CameraMinZoomDistance = 0.1
                    LocalPlayer.CameraMaxZoomDistance = 0.1
                end)
            elseif getgenv().FlyMethod == 2 then
                getgenv().startFlying()
            end
        else
            if getgenv().CFloop then getgenv().CFloop:Disconnect(); getgenv().CFloop = nil end
            if getgenv().FlyMethod == 2 or getgenv().flying then getgenv().stopFlying() end
            getgenv().SwimMethod = false
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false; hum:ChangeState(Enum.HumanoidStateType.Running) end
            local Head = char and char:FindFirstChild("Head")
            if Head then Head.Anchored = false end
            LocalPlayer.CameraMinZoomDistance = 0.5
            LocalPlayer.CameraMaxZoomDistance = 400
            for acc in pairs(getgenv().RemovedHair) do
                if char and not acc.Parent then acc.Parent = char end
            end
            getgenv().RemovedHair = {}
        end
    end
})
