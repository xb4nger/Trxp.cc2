local function getPlayerHealthValues(plr, hum)
    local char = plr and plr.Character
    hum = hum or (char and char:FindFirstChildOfClass("Humanoid"))
    local hp, maxHp
    if char then
        local a = char:GetAttribute("Health")
        if typeof(a) == "number" then hp = a end
        local m = char:GetAttribute("MaxHealth")
        if typeof(m) == "number" and m > 0 then maxHp = m end
    end
    if hum then
        if hp == nil then
            local a = hum:GetAttribute("Health")
            hp = (typeof(a) == "number") and a or hum.Health
        end
        if maxHp == nil then
            local m = hum:GetAttribute("MaxHealth")
            if typeof(m) == "number" and m > 0 then maxHp = m
            elseif hum.MaxHealth and hum.MaxHealth > 0 then maxHp = hum.MaxHealth end
        end
    end
    if (hp == nil or maxHp == nil) and plr then
        pcall(function()
            local rp = ReplicatedStorage:FindFirstChild("Players") and ReplicatedStorage.Players:FindFirstChild(plr.Name)
            local st = rp and rp:FindFirstChild("Status")
            if st then
                if hp == nil then
                    local a = st:GetAttribute("Health")
                    if typeof(a) == "number" then hp = a end
                end
                if maxHp == nil then
                    local m = st:GetAttribute("MaxHealth")
                    if typeof(m) == "number" and m > 0 then maxHp = m end
                end
            end
        end)
    end
    if typeof(hp) ~= "number" then hp = 0 end
    if typeof(maxHp) ~= "number" or maxHp <= 0 then maxHp = 100 end
    return hp, maxHp
end

local function getEquippedItemName(plr)
    if not plr then return "None" end
    local ok, name = pcall(function()
        local rsPlayers = ReplicatedStorage:FindFirstChild("Players")
        local rsPlr = rsPlayers and rsPlayers:FindFirstChild(plr.Name)
        local status = rsPlr and rsPlr:FindFirstChild("Status")
        local gv = status and status:FindFirstChild("GameplayVariables")
        local et = gv and gv:FindFirstChild("EquippedTool")
        if not et or et.Value == nil then return nil end
        local val = et.Value
        if typeof(val) == "Instance" then return val.Name end
        local s = tostring(val)
        if s == "" or s == "nil" then return nil end
        return s
    end)
    if ok and name and name ~= "" then return name end
    return "None"
end

