FarmsBox:Button()
:Add("Construction Farm", function()

    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local function getCharacter()
        return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    end

    local function getBackpack()
        return LocalPlayer:WaitForChild("Backpack")
    end

    local function findPrompt(name)
        local construction = workspace:WaitForChild("ConstructionStuff")
        local target = construction:FindFirstChild(name, true)

        if target then
            if target:IsA("ProximityPrompt") then
                return target
            end

            local nested = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if nested then
                return nested
            end
        end

        for _, obj in ipairs(construction:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and (obj.Name == name or (obj.Parent and obj.Parent.Name == name)) then
                return obj
            end
        end

        return nil
    end

    local function hasPlyWood()
        local backpack = getBackpack()
        local character = getCharacter()

        return backpack:FindFirstChild("PlyWood")
            or character:FindFirstChild("PlyWood")
    end

    local function equipPlyWood()
        local wood = getBackpack():FindFirstChild("PlyWood")

        if wood then
            wood.Parent = getCharacter()
        end
    end

    local function fireOnce(prompt)
        if prompt and prompt:IsA("ProximityPrompt") and prompt.Parent and prompt.Enabled then
            local success, err = pcall(function()
                fireproximityprompt(prompt)
            end)

            if not success then
                warn("Prompt activation failed:", err)
            end

            return success
        end

        return false
    end

    local function acTeleport(cf)
        local character = getCharacter()
        local humanoid = character:WaitForChild("Humanoid")
        local root = character:WaitForChild("HumanoidRootPart")

        humanoid:ChangeState(0)

        task.wait(0.6)

        repeat
            task.wait()
        until not LocalPlayer:GetAttribute("LastACPos")

        root.CFrame = cf
        task.wait(1.5)
    end

    local function startJob()
        local prompt = findPrompt("Start Job")
        if not prompt then
            error("Start Job prompt not found")
        end

        acTeleport(CFrame.new(-1728, 371, -1172))
        fireOnce(prompt)

        task.wait(0.5)
        print("Start Job activated")
    end

    local function grabWood()
        local prompt = findPrompt("Grab Wood")
        if not prompt then
            error("Grab Wood prompt not found")
        end

        acTeleport(CFrame.new(-1727, 371, -1178))
        task.wait(0.1)

        while not hasPlyWood() do
            if prompt and prompt.Parent and prompt.Enabled then
                fireOnce(prompt)
            end

            task.wait(0.1)
            equipPlyWood()

            if not prompt or not prompt.Parent then
                prompt = findPrompt("Grab Wood")
            end
        end

        equipPlyWood()
        print("Wood collected and equipped")
    end

    local function buildWall(promptName, position)
        local prompt = findPrompt(promptName)

        if not prompt then
            error("Missing build prompt: " .. promptName)
        end

        if not prompt.Enabled then
            return
        end

        if not hasPlyWood() then
            grabWood()
        end

        equipPlyWood()
        acTeleport(position)

        while prompt.Parent and prompt.Enabled do
            for i = 1, 30 do
                if not prompt.Parent or not prompt.Enabled then
                    break
                end

                fireOnce(prompt)
                task.wait(0.1)
            end

            task.wait(0.15)

            if not hasPlyWood() and prompt.Enabled then
                grabWood()
                equipPlyWood()
                acTeleport(position)
            end
        end

        print("Build prompt completed:", promptName)
    end

    task.spawn(function()
        local success, err = pcall(function()

            startJob()

            task.wait(0.2)

            if not hasPlyWood() then
                grabWood()
            end

            buildWall("Wall2 Prompt", CFrame.new(-1705, 368, -1151))
            buildWall("Wall3 Prompt", CFrame.new(-1732, 368, -1152))
            buildWall("Wall4 Prompt2", CFrame.new(-1772, 368, -1152))
            buildWall("Wall1 Prompt3", CFrame.new(-1674, 368, -1166))

            local quitPrompt = findPrompt("Quit Job")

            if quitPrompt then
                acTeleport(CFrame.new(-1728, 371, -1172))
                task.wait(0.2)
                fireOnce(quitPrompt)
            end
        end)

        if success then
            Notify("Construction Farm finished")
        else
            warn("Construction Farm error:", err)
            Notify("Construction Farm error - check console")
        end
    end)
end)


