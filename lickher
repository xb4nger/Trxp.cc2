local modConnection = nil
local function anyModEnabled()
    return getgenv().AlwaysAutomatic or getgenv().NoRecoil or getgenv().NoSpread or getgenv().FireRateBoost or getgenv().FastReload
end

local function startModLoop()
    if modConnection then return end
    modConnection = RunService.Heartbeat:Connect(function()
        if not anyModEnabled() then
            if modConnection then modConnection:Disconnect(); modConnection = nil end
            return
        end
        for _, weapon in ipairs(getgenv().WeaponTables) do
            pcall(function()
                rawset(weapon, "Auto", getgenv().AlwaysAutomatic)
                rawset(weapon, "CameraRecoilingEnabled", not getgenv().NoRecoil)
                rawset(weapon, "Recoil", getgenv().NoRecoil and 0 or (rawget(weapon, "Recoil") or 1))
                rawset(weapon, "Accuracy", getgenv().NoSpread and 0 or (rawget(weapon, "Accuracy") or 1))
                rawset(weapon, "FireRate", getgenv().FireRateBoost and 0.1 or (rawget(weapon, "FireRate") or 0.1))
                rawset(weapon, "ReloadTime", getgenv().FastReload and 0.2 or (rawget(weapon, "ReloadTime") or 1))
            end)
        end
    end)
end

