local function addColor(section, owner, label, default, cb)
    local function wrap(c)
        if typeof(c) == "Color3" then cb(c)
        elseif type(c) == "table" and typeof(c.Color) == "Color3" then cb(c.Color) end
    end
    local names = { "Colorpicker", "ColorPicker", "AddColorpicker", "AddColorPicker" }
    local function try(target)
        if target == nil then return false end
        for _, n in ipairs(names) do
            local okIdx, fn = pcall(function() return target[n] end)
            if okIdx and type(fn) == "function" then
                local ok = pcall(fn, target, { Name = label, Default = default, Callback = wrap })
                if ok then return true end
            end
        end
        return false
    end
    if try(owner) then return end
    local okL, lbl = pcall(function() return section:Label({ Name = label }) end)
    if okL then try(lbl) end
end

